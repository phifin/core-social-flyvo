{
  "Version": "2012-10-17",
  "Statement": [
    {"Effect": "Allow", "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:DeleteObject", "s3:DeleteObjectVersion"],
     "Resource": ["arn:aws:s3:::social-quarantine/incoming/*"]},
    {"Effect": "Allow", "Action": ["s3:PutObject", "s3:GetObject", "s3:GetObjectVersion", "s3:DeleteObject", "s3:DeleteObjectVersion"],
     "Resource": ["arn:aws:s3:::social-delivery/variants/*"]},
    {"Effect": "Allow", "Action": ["s3:ListBucket", "s3:ListBucketVersions"],
     "Resource": ["arn:aws:s3:::social-quarantine"],
     "Condition": {"StringLike": {"s3:prefix": ["incoming/*"]}}},
    {"Effect": "Allow", "Action": ["s3:ListBucket", "s3:ListBucketVersions"],
     "Resource": ["arn:aws:s3:::social-delivery"],
     "Condition": {"StringLike": {"s3:prefix": ["variants/*"]}}}
  ]
}
