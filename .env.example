# Copy to .env for Docker Compose only. Do not use these defaults in production.
POSTGRES_DB=social_core
POSTGRES_USER=social_core
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
APP_PORT=8080
SMTP_PORT=1025
MAILPIT_PORT=8025
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
FRONTEND_ORIGIN=http://localhost:3000
MEDIA_ENABLED=false
# Internal Compose endpoint and browser-facing presigner endpoint are distinct.
STORAGE_ENDPOINT=http://silo:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
# For the local app container, pass non-root APP_UID/APP_GID matching key ownership.
